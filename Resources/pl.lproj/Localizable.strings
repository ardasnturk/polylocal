/* Meeting mode: automatic start with Polylocal Microphone */
"Start automatically when a meeting app uses Polylocal Microphone" = "Uruchamiaj automatycznie, gdy aplikacja do spotkań używa Polylocal Microphone";
"Also when I start meeting subtitles from the menu bar" = "Także gdy uruchamiam napisy spotkania z paska menu";
"The language they speak (until known: %@)" = "Język, w którym mówią (do czasu rozpoznania: %@)";
"Choose their language so your first sentences are not spoken in %@." = "Wybierz ich język, aby twoje pierwsze zdania nie zostały wypowiedziane w języku: %@.";
"How to use it:" = "Jak tego używać:";
"1. Install Polylocal Microphone (administrator password once; the Mac's audio restarts briefly)." = "1. Zainstaluj Polylocal Microphone (jednorazowo hasło administratora; dźwięk Maca na chwilę uruchomi się ponownie).";
"2. Choose the language they speak above." = "2. Wybierz powyżej język, w którym mówią.";
"3. In Zoom, Meet or Teams, choose “Polylocal Microphone” as the microphone and join the call." = "3. W Zoom, Meet lub Teams wybierz „Polylocal Microphone” jako mikrofon i dołącz do rozmowy.";
"4. Polylocal starts by itself: speak your language, and they hear the translation about 3 seconds later. The subtitle bar shows what they heard." = "4. Polylocal uruchamia się sam: mów w swoim języku, a oni usłyszą tłumaczenie około 3 sekundy później. Pasek napisów pokazuje, co usłyszeli.";
"Use headphones. “Speaking translation” in the subtitle bar switches to your own voice and back." = "Używaj słuchawek. „Tłumaczenie jest odczytywane” na pasku napisów przełącza na twój własny głos i z powrotem.";
"%@ uses Polylocal Microphone, but meeting mode is off: the others hear silence." = "%@ używa Polylocal Microphone, ale tryb spotkania jest wyłączony: inni słyszą ciszę.";
"Start meeting mode" = "Uruchom tryb spotkania";
